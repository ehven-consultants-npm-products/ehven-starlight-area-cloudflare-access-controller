{
  "name": "@ehven/starlight-area-cloudflare-access-controller",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Roster authorization for independent protected areas, with Cloudflare Access and Starlight integrations.",
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./cloudflare": "./src/authorize.mjs",
    "./rosters": "./src/rosters.mjs",
    "./browser": "./src/access-snapshot.mjs",
    "./catalog": "./src/catalog.mjs",
    "./entitlements": "./src/entitlements.mjs",
    "./astro/AccessIdentity.astro": "./src/AccessIdentity.astro",
    "./astro/CourseNavigation.astro": "./src/CourseNavigation.astro"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "src/AccessIdentity.astro",
    "src/CourseNavigation.astro",
    "src/access-snapshot.d.mts",
    "src/access-snapshot.mjs",
    "src/authorize.d.mts",
    "src/authorize.mjs",
    "src/browser-lifecycle.mjs",
    "src/catalog.d.mts",
    "src/catalog.mjs",
    "src/entitlements.d.mts",
    "src/entitlements.mjs",
    "src/index.d.mts",
    "src/index.mjs",
    "src/paths.mjs",
    "src/policy.mjs",
    "src/rosters.d.mts",
    "src/rosters.mjs",
    "src/snapshot.mjs",
    "src/verify-identity.d.mts",
    "src/verify-identity.mjs"
  ],
  "sideEffects": [
    "./src/*.astro"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "npm test && npm run check:types && npm run check:astro",
    "check:types": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 test/types.mts",
    "check:astro": "astro build --root fixtures/starlight",
    "release:prepare": "node scripts/release.mjs prepare"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ehven-consultants-npm-products/ehven-starlight-area-cloudflare-access-controller.git"
  },
  "devDependencies": {
    "@astrojs/starlight": "0.41.11",
    "astro": "7.4.13",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@astrojs/starlight": "0.41.11",
    "astro": ">=7.3.8 <8"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "@astrojs/starlight": {
      "optional": true
    }
  },
  "homepage": "https://github.com/ehven-consultants-npm-products/ehven-starlight-area-cloudflare-access-controller#readme",
  "bugs": {
    "url": "https://github.com/ehven-consultants-npm-products/ehven-starlight-area-cloudflare-access-controller/issues"
  }
}
