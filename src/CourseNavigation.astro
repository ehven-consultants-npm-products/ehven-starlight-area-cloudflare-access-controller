---
interface Props { endpoint?: string; productionHostname: string; prereleaseHostname?: string; summaryPaths?: Record<string, string>; }
const { endpoint, productionHostname, prereleaseHostname, summaryPaths = {} } = Astro.props;
---
{endpoint && <div data-course-navigation data-endpoint={endpoint} data-host={productionHostname} data-preview-host={prereleaseHostname} data-summaries={JSON.stringify(summaryPaths)}>
	<p data-access-status role="status">Course links require enrollment. Access is checked when a course is opened.</p>
	<template data-course-lock>
		<svg class="course-enrollment-lock" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><rect x="3" y="11" width="18" height="10" rx="2" fill="currentColor" stroke="none" /><path d="M7 11V7a5 5 0 0 1 10 0v4" stroke-linecap="round" /></svg>
	</template>
</div>}
<style is:global>
	.course-enrollment-lock { display: inline-block; color: var(--ehven-color-isstop-background-default, #8c1d22); vertical-align: -2px; flex-shrink: 0; }
	.course-enrollment-lock-gap { display: inline-block; inline-size: 6px; white-space: nowrap; }
	.course-enrollment-lock-tail { display: inline-block; white-space: nowrap; }
	[data-course-locked] > span:first-child { display: inline; margin-inline-end: 0; }
	.course-enrollment-lock-description { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
	site-search[data-access-unavailable] { display: none !important; }
</style>
<script>
	import { accessDOM, onAccessPage } from './browser-lifecycle.mjs';
	import { normalizePathname, pathWithinRoot } from './paths.mjs';

	function summaryFor(value: unknown) {
		if (typeof value !== 'string') return;
		try { return normalizePathname(value); } catch { return; }
	}

	onAccessPage(async (load, signal) => {
		const widget = document.querySelector<HTMLElement>('[data-course-navigation]');
		if (!widget?.dataset.endpoint || ![widget.dataset.host, widget.dataset.previewHost].includes(location.hostname)) return;

		const dom = accessDOM(signal);
		const searchScope = new AbortController();
		signal.addEventListener('abort', () => searchScope.abort(), { once: true });
		const searchDOM = accessDOM(searchScope.signal);
		for (const search of document.querySelectorAll('site-search')) {
			searchDOM.attribute(search, 'data-access-unavailable', '');
			const button = search.querySelector('button[data-open-modal]');
			if (button) searchDOM.attribute(button, 'disabled', '');
			search.querySelector<HTMLDialogElement>('dialog[open]')?.close();
		}
		window.addEventListener('keydown', event => {
			if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
				event.preventDefault();
				event.stopImmediatePropagation();
			}
		}, { capture: true, signal: searchScope.signal });

		try {
			const { courses } = await load(widget.dataset.endpoint);
			if (signal.aborted || !widget.isConnected) return;
			if (courses.length > 0 && courses.every(course => course.allowed)) searchScope.abort();

			const summaryPaths = JSON.parse(widget.dataset.summaries || '{}');
			const icon = widget.querySelector<HTMLTemplateElement>('[data-course-lock]')?.content.firstElementChild;
			if (!icon) return;
			const lock = () => icon.cloneNode(true);
			const denied = courses.filter(course => !course.allowed);
			for (const link of document.querySelectorAll<HTMLAnchorElement>('.sidebar a[href]')) {
				const url = new URL(link.href);
				if (url.origin !== location.origin) continue;
				const course = denied.find(course => pathWithinRoot(url.pathname, course.path));
				if (!course) continue;
				if (link.hasAttribute('data-course-lesson')) {
					const item = link.closest('li');
					if (item) dom.attribute(item, 'hidden', '');
					continue;
				}
				if (!link.hasAttribute('data-course-overview') || link.hasAttribute('data-course-locked')) continue;
				const title = link.textContent?.trim() || 'Coachware';
				const summary = summaryFor(summaryPaths?.[course.path]);
				if (summary) {
					dom.attribute(link, 'href', summary);
					if (summary === location.pathname) dom.attribute(link, 'aria-current', 'page');
				}
				dom.attribute(link, 'aria-label', summary
					? `${title}. Additional enrollment required. View summary and request access.`
					: `${title}. Additional enrollment required.`);
				dom.attribute(link, 'data-course-locked', 'true');
				const tail = document.createElement('span');
				tail.className = 'course-enrollment-lock-tail';
				const gap = document.createElement('span');
				gap.className = 'course-enrollment-lock-gap';
				gap.textContent = '\u00a0';
				const words = /^(.*\s)?(\S+)$/.exec(title);
				tail.append(words?.[2] || title, gap, lock());
				dom.children(link.querySelector('span') || link, words?.[1] || '', tail);
			}
			const status = widget.querySelector('[data-access-status]');
			if (status) {
				const description = document.createElement('span');
				description.className = 'course-enrollment-lock-description';
				description.textContent = 'with a lock';
				dom.children(status, 'Coachware marked ', lock(), description, ' requires additional enrollment.');
			}
		} catch {
			// Keep the initial navigation and the conservative search state.
		}
	});
</script>
