---
interface Props { endpoint?: string; productionHostname: string; prereleaseHostname?: string; summaryPaths?: Record<string, string>; }
const { endpoint, productionHostname, prereleaseHostname, summaryPaths = {} } = Astro.props;
---
{endpoint && <div data-course-navigation data-endpoint={endpoint} data-host={productionHostname} data-preview-host={prereleaseHostname} data-summaries={JSON.stringify(summaryPaths)}>
	<p data-access-status role="status">Course links require enrollment. Access is checked when a course is opened.</p>
	<template data-course-lock>
		<svg class="course-enrollment-lock" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><rect x="3" y="11" width="18" height="10" rx="2" fill="currentColor" stroke="none" /><path d="M7 11V7a5 5 0 0 1 10 0v4" stroke-linecap="round" /></svg>
	</template>
</div>}
<style is:global>
	.course-enrollment-lock { display: inline-block; color: var(--ehven-color-isstop-background-default, #8c1d22); vertical-align: -2px; flex-shrink: 0; }
	.course-enrollment-lock-gap { display: inline-block; inline-size: 6px; white-space: nowrap; }
	.course-enrollment-lock-tail { display: inline-block; white-space: nowrap; }
	[data-course-locked] > span:first-child { display: inline; margin-inline-end: 0; }
	.course-enrollment-lock-description { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
	site-search[data-access-unavailable] { display: none !important; }
</style>
<script>
	import { loadAccessSnapshot } from './access-snapshot.mjs';
	let searchRestricted = false;
	function sharedSearchAvailable(available: boolean) {
		searchRestricted = !available;
		for (const search of document.querySelectorAll<HTMLElement>('site-search')) {
			search.toggleAttribute('data-access-unavailable', !available);
			const button = search.querySelector<HTMLButtonElement>('button[data-open-modal]');
			if (button) button.disabled = !available;
			if (!available) search.querySelector<HTMLDialogElement>('dialog[open]')?.close();
		}
	}
	// Starlight's window shortcut opens its dialog directly, bypassing the button.
	window.addEventListener('keydown', (event) => {
		if (searchRestricted && (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
			event.preventDefault();
			event.stopImmediatePropagation();
		}
	}, { capture: true });
	async function refreshCourseNavigation() {
		const widget = document.querySelector<HTMLElement>('[data-course-navigation]');
		if (!widget?.dataset.endpoint || ![widget.dataset.host, widget.dataset.previewHost].includes(location.hostname)) return;
		sharedSearchAvailable(false);
		try {
			const { courses } = await loadAccessSnapshot(widget.dataset.endpoint);
			if (!Array.isArray(courses)) throw new Error('Enrollment unavailable');
			sharedSearchAvailable(courses.length > 0 && courses.every((course) => course.allowed === true));
			const summaryPaths = JSON.parse(widget.dataset.summaries || '{}');
			const template = widget.querySelector<HTMLTemplateElement>('[data-course-lock]');
			const icon = template?.content.firstElementChild;
			if (!icon) throw new Error('Lock icon unavailable');
			const lock = () => icon.cloneNode(true);
			for (const course of courses) {
				if (course.allowed || typeof course.path !== 'string') continue;
				for (const link of document.querySelectorAll<HTMLAnchorElement>('.sidebar a[href]')) {
					const pathname = new URL(link.href).pathname.replace(/\/$/, '');
					if (pathname !== course.path && !pathname.startsWith(`${course.path}/`)) continue;
					if (link.hasAttribute('data-course-lesson')) { link.closest('li')?.setAttribute('hidden', ''); continue; }
					if (!link.hasAttribute('data-course-overview') || link.dataset.courseLocked) continue;
					const title = link.textContent?.trim() || 'Coachware';
					const summary = summaryPaths[course.path];
					if (typeof summary === 'string' && summary.startsWith('/') && !summary.startsWith('//')) {
						link.href = summary;
						if (new URL(link.href).pathname === location.pathname) link.setAttribute('aria-current', 'page');
						link.setAttribute('aria-label', `${title}. Additional enrollment required. View summary and request access.`);
					} else {
						link.setAttribute('aria-label', `${title}. Additional enrollment required.`);
					}
					link.dataset.courseLocked = 'true';
					const tail = document.createElement('span');
					tail.className = 'course-enrollment-lock-tail';
					const gap = document.createElement('span');
					gap.className = 'course-enrollment-lock-gap';
					gap.textContent = '\u00a0';
					const words = /^(.*\s)?(\S+)$/.exec(title);
					tail.append(words?.[2] || title, gap, lock());
					const label = link.querySelector('span') || link;
					label.replaceChildren(words?.[1] || '', tail);
				}
			}
			const status = widget.querySelector('[data-access-status]');
			if (status) {
				const description = document.createElement('span');
				description.className = 'course-enrollment-lock-description';
				description.textContent = 'with a lock';
				status.replaceChildren('Coachware marked ', lock(), description, ' requires additional enrollment.');
			}
		} catch { /* Request-time authorization still protects every course if navigation cannot refresh. */ }
	}
	refreshCourseNavigation();
</script>
